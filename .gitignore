# AI-Choices-Atlas — the atlas content/data plus the portable workflow and
# tooling set are tracked. Machine-local state and private evidence are not.

# --- Machine-local state & private evidence (never tracked, both modes) ---
.beads/
.mba/
.mba-work/
.opencode/
opencode.json

# --- Dependencies / build / OS junk ---
node_modules/
__pycache__/
*.py[cod]
*.db
*.log
.DS_Store
Thumbs.db

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# --- Agent config dirs stay private by default; the portable set below is
# --- versioned so every machine gets the exact same instruction files.
.agents/
.claude/

!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/beads/
.agents/skills/beads/*
!.agents/skills/beads/SKILL.md
!.agents/skills/beads/agents/
.agents/skills/beads/agents/*
!.agents/skills/beads/agents/openai.yaml
!.agents/skills/mba/
.agents/skills/mba/*
!.agents/skills/mba/SKILL.md

!.claude/
.claude/*
!.claude/settings.json
