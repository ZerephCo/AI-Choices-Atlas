AGENTS.md
CLAUDE.md

# --- Internal docs (not part of the atlas) ---
docs/mba/
docs/beads/

# --- Dependencies / build / OS junk ---
node_modules/
__pycache__/
*.py[cod]
*.db
*.log
.DS_Store
Thumbs.db

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# --- Shared Zereph Beads workflow ---
