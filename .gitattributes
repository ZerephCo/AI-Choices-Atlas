# Portable text, data, and tooling are LF on every OS: bd setup and the MBA
# installer compare managed instruction files byte-for-byte, and the docs
# generator's --check mode compares generated pages byte-for-byte on disk.
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.mjs text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
